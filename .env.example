# Django runtime settings
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:4200,http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:4200,http://localhost:3000

# Local Compose and CI use the isolated SQLite test database.
DATABASE_URL=
DATABASE_URL_TEST=sqlite:////app/src/db.sqlite3

# Render/Neon sets DATABASE_URL externally. Use DB_SSLMODE=require only for split PostgreSQL settings.
DB_SSLMODE=

# Split variables are retained as a local fallback when no database URL is set.
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=/app/src/db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Frontend links and optional SMTP settings
# Production Neon, Render and Vercel URLs must be configured only in Render/Vercel Environment Variables.
FRONTEND_URL=http://localhost:4200
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=